# Copy to .env and adjust for your Pi-hole instance.
PIHOLE_HOSTNAME=192.168.1.2
PIHOLE_PASSWORD=your-pihole-api-token-or-password
PIHOLE_PORT=80
PIHOLE_PROTOCOL=http

# Optional HTTPS for the exporter HTTP server (both must be set).
# TLS_CERT_FILE=/certs/tls.crt
# TLS_KEY_FILE=/certs/tls.key

# Exporter listen port published on the host (container always listens on 9617).
# PORT=9617
